# Edge Function secrets (spec §10.4). Set in production with `supabase secrets set --env-file`.
# Never commit real values; never expose these to the app bundle.
ANTHROPIC_API_KEY=
OPEN_METEO_API_KEY=
SMS_PROVIDER_ACCOUNT_SID=
SMS_PROVIDER_AUTH_TOKEN=
SMS_PROVIDER_FROM=
# SUPABASE_SERVICE_ROLE_KEY is injected automatically into Edge Functions.
