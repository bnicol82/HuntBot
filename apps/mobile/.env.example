# App (public — safe to bundle)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
EXPO_PUBLIC_MAPBOX_TOKEN=

# Google Sign-In (public client IDs; leave blank to hide the Google button)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Build-time only: reversed iOS client ID, e.g. com.googleusercontent.apps.123-abc
GOOGLE_IOS_URL_SCHEME=

# Build-time only
APP_BUNDLE_ID=
EAS_PROJECT_ID=
# Mapbox SDK download token: no longer required by @rnmapbox/maps 10.3 (see docs/DECISIONS.md)

# Server secrets (ANTHROPIC_API_KEY, SUPABASE_SERVICE_ROLE_KEY, ...) never go here.
# They live in Supabase Edge Function secrets — see supabase/.env.example.
