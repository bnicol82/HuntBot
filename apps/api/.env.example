# Neon (added automatically by the Vercel ↔ Neon integration)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Better Auth
BETTER_AUTH_SECRET=          # openssl rand -base64 32
BETTER_AUTH_URL=             # e.g. https://api.huntbot.app

# Native sign-in (leave blank to disable a provider)
APPLE_BUNDLE_ID=             # iOS bundle ID; Apple ID tokens are issued to it
GOOGLE_CLIENT_IDS=           # comma-separated: web client ID, iOS client ID

# Later milestones — server only, never in the app bundle
# ANTHROPIC_API_KEY=
# OPEN_METEO_API_KEY=
# SMS_PROVIDER_*=
# CRON_SECRET=
