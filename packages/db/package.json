{
  "name": "@huntbot/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "migrate": "node src/migrate.ts",
    "test:sql": "pg_prove --dbname \"${DATABASE_URL:?set DATABASE_URL}\" tests/*.test.sql"
  },
  "dependencies": {
    "@huntbot/shared": "workspace:*",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1"
  }
}
